# =============================================================================
# git/gitconfig.local.example
# Copy this to ~/.gitconfig.local and fill in your details.
# This file is NOT tracked in git (contains personal info).
# =============================================================================

[user]
  name       = Your Name
  email      = you@example.com
  # Optional: GPG/SSH signing key
  # signingkey = ~/.ssh/id_ed25519.pub

[commit]
  # gpgsign = true
