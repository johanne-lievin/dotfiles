#!/usr/bin/env bash
# =============================================================================
# bin/dots — Dotfiles-aware package manager wrapper
# Usage:
#   dots brew install foo        → brew install + add to Brewfile + commit/push
#   dots brew uninstall foo      → brew uninstall + remove from Brewfile + commit/push
#   dots cask install foo        → same for casks
#   dots alias "name" "command"  → add alias to zsh/aliases.zsh + commit/push
#   dots sync                    → pull latest, brew bundle, re-symlink
#   dots status                  → show drift between machine and dotfiles
# =============================================================================

set -uo pipefail

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
BREWFILE="$DOTFILES/Brewfile"

# ── Helpers ──────────────────────────────────────────────────────────────────
BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
RESET='\033[0m'

ok()   { echo -e "  ${GREEN}✓${RESET} $1"; }
warn() { echo -e "  ${YELLOW}⚠${RESET}  $1"; }
err()  { echo -e "  ${RED}✗${RESET} $1"; }
step() { echo -e "\n${CYAN}▶ ${BOLD}$1${RESET}"; }

dots_commit_push() {
  local msg="$1"
  cd "$DOTFILES"
  if git diff --quiet && git diff --staged --quiet; then
    warn "Nothing to commit"
    return
  fi
  git add -A
  git commit -m "$msg"
  if git remote | grep -q origin; then
    git push && ok "Pushed to remote" || warn "Push failed — committed locally"
  else
    warn "No remote configured — committed locally only"
  fi
}

# ── dots brew install <formula> [formula...] ──────────────────────────────────
cmd_brew_install() {
  local packages=("$@")
  [ ${#packages[@]} -eq 0 ] && { err "Usage: dots brew install <package>"; exit 1; }

  step "Installing ${packages[*]} via brew"
  brew install "${packages[@]}" || { err "brew install failed"; exit 1; }
  ok "Installed"

  step "Adding to Brewfile"
  for pkg in "${packages[@]}"; do
    if ! grep -q "\"$pkg\"" "$BREWFILE"; then
      echo "brew \"$pkg\"" >> "$BREWFILE"
      ok "Added brew \"$pkg\" to Brewfile"
    else
      warn "brew \"$pkg\" already in Brewfile"
    fi
  done

  dots_commit_push "feat: add brew ${packages[*]}"
}

# ── dots cask install <cask> [cask...] ───────────────────────────────────────
cmd_cask_install() {
  local casks=("$@")
  [ ${#casks[@]} -eq 0 ] && { err "Usage: dots cask install <cask>"; exit 1; }

  step "Installing ${casks[*]} via brew cask"
  brew install --cask "${casks[@]}" || { err "brew install --cask failed"; exit 1; }
  ok "Installed"

  step "Adding to Brewfile"
  for cask in "${casks[@]}"; do
    if ! grep -q "\"$cask\"" "$BREWFILE"; then
      echo "cask \"$cask\"" >> "$BREWFILE"
      ok "Added cask \"$cask\" to Brewfile"
    else
      warn "cask \"$cask\" already in Brewfile"
    fi
  done

  dots_commit_push "feat: add cask ${casks[*]}"
}

# ── dots brew uninstall <formula> ────────────────────────────────────────────
cmd_brew_uninstall() {
  local packages=("$@")
  [ ${#packages[@]} -eq 0 ] && { err "Usage: dots brew uninstall <package>"; exit 1; }

  step "Uninstalling ${packages[*]}"
  brew uninstall "${packages[@]}" || warn "brew uninstall had errors"

  step "Removing from Brewfile"
  for pkg in "${packages[@]}"; do
    if grep -q "brew \"$pkg\"" "$BREWFILE"; then
      # Cross-platform sed (macOS requires -i '')
      sed -i '' "/^brew \"$pkg\"/d" "$BREWFILE"
      ok "Removed brew \"$pkg\" from Brewfile"
    else
      warn "brew \"$pkg\" not found in Brewfile"
    fi
  done

  dots_commit_push "chore: remove brew ${packages[*]}"
}

# ── dots cask uninstall <cask> ───────────────────────────────────────────────
cmd_cask_uninstall() {
  local casks=("$@")
  [ ${#casks[@]} -eq 0 ] && { err "Usage: dots cask uninstall <cask>"; exit 1; }

  step "Uninstalling cask ${casks[*]}"
  brew uninstall --cask "${casks[@]}" || warn "brew uninstall --cask had errors"

  step "Removing from Brewfile"
  for cask in "${casks[@]}"; do
    if grep -q "cask \"$cask\"" "$BREWFILE"; then
      sed -i '' "/^cask \"$cask\"/d" "$BREWFILE"
      ok "Removed cask \"$cask\" from Brewfile"
    else
      warn "cask \"$cask\" not found in Brewfile"
    fi
  done

  dots_commit_push "chore: remove cask ${casks[*]}"
}

# ── dots alias <name> <command> ───────────────────────────────────────────────
cmd_alias() {
  local name="${1:-}"
  shift
  local command="${*:-}"
  [ -z "$name" ] || [ -z "$command" ] && { err 'Usage: dots alias <name> "<command>"'; exit 1; }

  local alias_file="$DOTFILES/zsh/aliases.zsh"
  local alias_line="alias $name=\"$command\""

  if grep -q "^alias $name=" "$alias_file"; then
    warn "Alias '$name' already exists — updating"
    sed -i '' "/^alias $name=/c\\
$alias_line" "$alias_file"
  else
    echo "$alias_line" >> "$alias_file"
    ok "Added alias: $alias_line"
  fi

  # Reload aliases in current shell
  source "$alias_file" 2>/dev/null || true

  dots_commit_push "feat: add alias $name"
}

# ── dots sync ─────────────────────────────────────────────────────────────────
cmd_sync() {
  step "Pulling latest dotfiles"
  cd "$DOTFILES"
  git pull --rebase && ok "Up to date" || warn "Pull had conflicts"

  step "Installing Brewfile packages"
  brew bundle --file="$BREWFILE" || warn "Some packages failed"

  step "Re-symlinking dotfiles"
  bash "$DOTFILES/bin/symlink.sh"

  ok "Sync complete — restart your terminal"
}

# ── dots status ───────────────────────────────────────────────────────────────
cmd_status() {
  # Called by dots-status.zsh on terminal start — also callable manually
  bash "$DOTFILES/bin/dots-status.sh"
}

# ── dots edit ─────────────────────────────────────────────────────────────────
cmd_edit() {
  "${EDITOR:-cursor}" "$DOTFILES"
}

# ── dots commit ───────────────────────────────────────────────────────────────
cmd_commit() {
  local msg="${*:-chore: update dotfiles}"
  dots_commit_push "$msg"
}

# ── Help ─────────────────────────────────────────────────────────────────────
cmd_help() {
  echo ""
  echo -e "${BOLD}dots${RESET} — dotfiles-aware package manager"
  echo ""
  echo "  dots brew install <pkg>       Install formula + add to Brewfile + push"
  echo "  dots brew uninstall <pkg>     Uninstall formula + remove from Brewfile + push"
  echo "  dots cask install <cask>      Install cask + add to Brewfile + push"
  echo "  dots cask uninstall <cask>    Uninstall cask + remove from Brewfile + push"
  echo "  dots alias <name> <cmd>       Add shell alias + push"
  echo "  dots sync                     Pull + brew bundle + re-symlink"
  echo "  dots status                   Show drift report"
  echo "  dots edit                     Open dotfiles in \$EDITOR"
  echo "  dots commit [message]         Commit + push any pending changes"
  echo ""
}

# ── Router ───────────────────────────────────────────────────────────────────
case "${1:-help}" in
  brew)
    subcmd="${2:-}"
    shift 2 2>/dev/null || shift $# 2>/dev/null
    case "$subcmd" in
      install)   cmd_brew_install "$@" ;;
      uninstall) cmd_brew_uninstall "$@" ;;
      *) err "Unknown brew subcommand: $subcmd. Use install or uninstall." ;;
    esac
    ;;
  cask)
    subcmd="${2:-}"
    shift 2 2>/dev/null || shift $# 2>/dev/null
    case "$subcmd" in
      install)   cmd_cask_install "$@" ;;
      uninstall) cmd_cask_uninstall "$@" ;;
      *) err "Unknown cask subcommand: $subcmd. Use install or uninstall." ;;
    esac
    ;;
  alias)   shift; cmd_alias "$@" ;;
  sync)    cmd_sync ;;
  status)  cmd_status ;;
  edit)    cmd_edit ;;
  commit)  shift; cmd_commit "$@" ;;
  help|--help|-h) cmd_help ;;
  *) err "Unknown command: $1"; cmd_help; exit 1 ;;
esac
